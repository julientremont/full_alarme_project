[Unit]
Description=AEGIS — supervision alarme (Flask)
After=network.target docker.service
Wants=network-online.target

[Service]
Type=simple
User=j.tremont
Group=j.tremont
WorkingDirectory=/home/j.tremont/Documents/Projets/full_alarme_project/webapp
EnvironmentFile=/home/j.tremont/Documents/Projets/full_alarme_project/webapp/.env
Environment="PATH=/home/j.tremont/Documents/Projets/full_alarme_project/webapp/.venv/bin:/usr/bin:/bin"
ExecStart=/home/j.tremont/Documents/Projets/full_alarme_project/webapp/.venv/bin/gunicorn \
    --workers 1 --threads 8 --bind 127.0.0.1:5002 app:app

# Durcissement
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/home/j.tremont/Documents/Projets/full_alarme_project/webapp
Restart=on-failure
RestartSec=5

StandardOutput=journal
StandardError=journal
SyslogIdentifier=aegis

[Install]
WantedBy=multi-user.target
