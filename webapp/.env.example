# ─── SÉCURITÉ ─────────────────────────────────────────────────────────────────
# Générer : python -c "import secrets; print(secrets.token_hex(32))"
AEGIS_SECRET_KEY=REMPLACER_PAR_UNE_CLE_HEX_64_CHARS

# Derrière le tunnel Cloudflare (HTTPS) → true
HTTPS=true

# Usernames admin (CSV)
ADMIN_USERS=julien

# ─── MQTT (Mosquitto, conteneur Docker network host) ─────────────────────────
MQTT_HOST=127.0.0.1
MQTT_PORT=1883
MQTT_BASE_TOPIC=zigbee2mqtt
# Laisser vide si Mosquitto en allow_anonymous
MQTT_USERNAME=
MQTT_PASSWORD=

# ─── CAMÉRAS (optionnel) ──────────────────────────────────────────────────────
# Convention : AEGIS_CAMERA_<KEY>_<CHAMP>, avec <KEY> = clé de la caméra en MAJUSCULES.
# Exemple pour `cam_entree` :
# AEGIS_CAMERA_CAM_ENTREE_VIEWER_URL=https://go2rtc.local/stream.html?src=entree
# AEGIS_CAMERA_CAM_ENTREE_VIEWER_MODE=iframe   # iframe | video | image
# AEGIS_CAMERA_CAM_ENTREE_SNAPSHOT_URL=https://go2rtc.local/api/frame.jpeg?src=entree
# AEGIS_CAMERA_CAM_ENTREE_TRANSPORT=RTSP -> go2rtc
# AEGIS_CAMERA_CAM_ENTREE_NOTE=Passerelle vidéo intérieure
