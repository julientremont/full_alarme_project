# L'orchestrateur lit d'abord /home/j.tremont/.secrets/vault.env (déjà rempli :
# TAPO_*, MAIL_*, PATH_DRIVE_ENTREE_TAPO_CAPTURES). Ce .env local est optionnel
# et sert à surcharger / compléter.

# MQTT (Mosquitto en Docker, network host)
MQTT_HOST=127.0.0.1
MQTT_PORT=1883
MQTT_BASE_TOPIC=zigbee2mqtt

# Caméra
CAMERA_LABEL=Salon
TAPO_STREAM=stream1

# Prises Tapo — compte CLOUD Tapo (login appli), différent du compte local caméra.
# (défini dans le vault : TAPO_CLOUD_EMAIL / TAPO_CLOUD_PASSWORD)
PLUG_POLL_S=20

# Comportement détection
MOTION_GAP_S=2          # intervalle comparaison d'images (veille)
ALARM_PHOTO_S=10        # photo + YOLO toutes les N s pendant l'alarme
ENTRY_DELAY_S=60        # tempo porte d'entrée avant déclenchement (le temps de désarmer)
ENTRY_SENSORS=porte_entree   # capteurs à tempo (CSV)
ALERT_COOLDOWN_S=300    # anti-spam alertes (s)
AEGIS_APP_URL=https://aegis.tremontraimi.com
