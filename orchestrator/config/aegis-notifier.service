[Unit]
Description=AEGIS — service de messagerie (alertes, rappels, récapitulatif)
After=network.target docker.service
Wants=network-online.target

[Service]
Type=simple
User=j.tremont
Group=j.tremont
WorkingDirectory=/home/j.tremont/Documents/Projets/full_alarme_project/orchestrator
Environment="PATH=/home/j.tremont/Documents/Projets/full_alarme_project/orchestrator/.venv/bin:/usr/bin:/bin"
ExecStart=/home/j.tremont/Documents/Projets/full_alarme_project/orchestrator/.venv/bin/python notifier.py

NoNewPrivileges=true
PrivateTmp=true
Restart=always
RestartSec=10

StandardOutput=journal
StandardError=journal
SyslogIdentifier=aegis-notifier

[Install]
WantedBy=multi-user.target
