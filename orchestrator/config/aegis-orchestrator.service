[Unit]
Description=AEGIS — orchestrateur alarme (MQTT, caméra, détection)
After=network.target docker.service
Wants=network-online.target

[Service]
Type=simple
User=j.tremont
Group=j.tremont
WorkingDirectory=/home/j.tremont/Documents/Projets/full_alarme_project/orchestrator
Environment="PATH=/home/j.tremont/Documents/Projets/full_alarme_project/orchestrator/.venv/bin:/usr/bin:/bin"
ExecStart=/home/j.tremont/Documents/Projets/full_alarme_project/orchestrator/.venv/bin/python alarm.py

NoNewPrivileges=true
PrivateTmp=true
Restart=on-failure
RestartSec=10

StandardOutput=journal
StandardError=journal
SyslogIdentifier=aegis-orchestrator

[Install]
WantedBy=multi-user.target
